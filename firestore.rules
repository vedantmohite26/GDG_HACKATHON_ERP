rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin()     { return isRole('admin'); }
    function isCommittee() { return isRole('committee'); }
    function isFaculty()   { return isRole('faculty'); }

    // --- DATA VALIDATION FUNCTIONS ---
    function validateStudentProfile(data) {
      return data.name is string && 
             data.studentUID is string && 
             data.course is string &&
             data.year is int &&
             data.contactNumber is string &&
             data.shift in ['FIRST', 'SECOND'];
    }

    // --- COLLECTIONS ---

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); 
      allow create: if isOwner(userId); 
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin() || isCommittee();
    }

    // Student Profiles
    match /student_profiles/{docId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(request.resource.data.userId) || isAdmin());
      allow update: if isOwner(resource.data.userId) || isAdmin() || isCommittee();
      allow delete: if isAdmin() || isCommittee();
    }

    // Faculty Profiles
    match /faculty_profiles/{userId} {
      allow read: if isAuthenticated(); 
      allow write: if isAdmin() || isOwner(userId) || isCommittee();
    }

    // Scholarships
    match /scholarships/{scholarshipId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCommittee();
    }
    
    // Applications
    match /applications/{applicationId} {
      allow read:   if isAuthenticated() && (
        isAdmin() || 
        isCommittee() || 
        isFaculty() ||
        resource.data.studentUID == getUserData().studentUID
      );
      allow create: if isAuthenticated() && request.resource.data.studentUID == getUserData().studentUID;
      allow update: if isAdmin() || isCommittee() || 
                    (isFaculty() && resource.data.assignedFacultyId == request.auth.uid) ||
                    (isAuthenticated() && resource.data.studentUID == getUserData().studentUID && resource.data.status == 'pending');
      allow delete: if isAdmin() || isCommittee();
    }
    
    // Documents Meta
    match /documents_meta/{docId} {
       allow read: if isAuthenticated() && (
         isAdmin() || 
         isCommittee() || 
         isFaculty() || 
         resource.data.studentUID == getUserData().studentUID
       );
       allow create: if isAuthenticated() && request.resource.data.studentUID == getUserData().studentUID;
       allow update: if isAdmin() || isCommittee() || isFaculty() || (isAuthenticated() && resource.data.studentUID == getUserData().studentUID);
       allow delete: if isAdmin() || isCommittee() || (isAuthenticated() && resource.data.studentUID == getUserData().studentUID);
    }

    // Events
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCommittee() || isFaculty();
    }

    // Academic Info
    match /academic_info/{docId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isCommittee() || 
        isFaculty() || 
        getUserData().studentUID == docId
      );
      allow write: if isAdmin() || isCommittee() || isFaculty();
    }
    
    // Grievances
    match /grievances/{grievanceId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        isAdmin() || 
        isCommittee() || 
        isFaculty()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isCommittee() || 
                    (isFaculty() && (resource.data.assignedTo == request.auth.uid || resource.data.status == 'pending')) ||
                    isOwner(resource.data.userId);
      allow delete: if isAdmin() || isCommittee();
    }
    
    // Attendance Logs
    match /attendance_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isFaculty() || isAdmin();
      allow update: if isFaculty() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Notices
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCommittee() || isFaculty();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated(); 
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isCommittee();
      allow write: if isAuthenticated(); 
    }
  }
}

